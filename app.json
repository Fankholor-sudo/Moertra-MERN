{
  "expo": {
    "name": "Meortra",
    "slug": "meortra",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "meortra",
    "icon": "./public/icon.svg",
    "splash": {
      "backgroundColor": "#152844"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meortra.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#152844"
      },
      "package": "com.meortra.app"
    },
    "entryPoint": "node_modules/expo/AppEntry.js"
  }
}
